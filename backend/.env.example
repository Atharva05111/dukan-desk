# PostgreSQL (must have pgvector extension available)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dukan_desk?schema=public"

# Redis (BullMQ jobs: AI menu scan, embedding indexing)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

# Gemini
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_VISION_MODEL="gemini-1.5-pro"
GEMINI_TEXT_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Object storage (S3-compatible) for menu photos / bill PDFs
S3_BUCKET="dukan-desk-uploads"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

PORT=3000
